{
  "name": "rd-open-platform-backend",
  "version": "1.0.0",
  "description": "Random Dance Chinese Site Open Platform - Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test": "npm run build && node --test dist/modules/auth/*.spec.js dist/modules/notification-drafts/*.spec.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed:admin": "node dist/scripts/seed-admin.js",
    "seed:organizer": "node -r dotenv/config dist/scripts/seed-organizer.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "multer": "^2.0.0",
    "mysql2": "^3.22.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typescript": "~5.7.0",
    "uuid": "^11.0.0",
    "@volcengine/tos-sdk": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
