DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d
PORT=3002
FASTAPI_BASE_URL=https://chunyin.jilllees.top:8443/api

# 可选：本地上传目录（TOS 未启用时的回退落盘位置，同时是 /uploads 静态服务根目录）。
# 缺省为 process.cwd()/uploads（pm2 下 cwd=backend/，即 backend/uploads，位于 dist 之外，不会被 deleteOutDir 清空）。
# UPLOAD_DIR=/www/wwwroot/chaojifather.me/backend/uploads

# 可选：对象存储 Secret Access Key 的加密主密钥（AES-256-GCM）。
# 缺省回退使用 JWT_SECRET。注意：一旦轮换 JWT_SECRET，已保存的密文将无法解密，
# 因此在轮换 JWT_SECRET 之前必须显式设置本项并保持稳定，否则管理后台会提示 secretUnreadable。
# OBJECT_STORAGE_CONFIG_ENCRYPTION_KEY=change-this-to-a-dedicated-encryption-key
